{
    "name": "flowd/typo3-phixture",
    "description": "Test fixtures for TYPO3 as code: object-oriented factories that write through the DataHandler, a declared page tree per site, and tests that render a page in-process and assert on its DOM",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "typo3",
        "testing",
        "fixtures",
        "factories",
        "acceptance"
    ],
    "repositories": {
        "fixtures": {
            "type": "path",
            "url": "Tests/Fixtures/Packages/*"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "sort-packages": true
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-dom": "*",
        "ext-gd": "*",
        "masterminds/html5": "^2.9",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "symfony/css-selector": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/testing-framework": "^9.2"
    },
    "require-dev": {
        "flowd/typo3-phixture-fixture": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
        "typo3/minimal": "^13.4 || ^14.3"
    },
    "autoload": {
        "psr-4": {
            "Flowd\\Typo3Phixture\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flowd\\Typo3Phixture\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "typo3/cms": {
            "extension-key": "phixture",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "check:lint": [
            "parallel-lint Classes Tests"
        ],
        "check:cgl": [
            "php-cs-fixer fix -n --diff --format=txt --dry-run"
        ],
        "ci:check:cgl": [
            "php-cs-fixer fix -n --diff --format=checkstyle --dry-run"
        ],
        "fix:cgl": [
            "php-cs-fixer fix -n --diff --format=txt"
        ],
        "check:phpstan": [
            "phpstan --memory-limit=1G"
        ],
        "ci:check:phpstan": [
            "phpstan --memory-limit=1G --error-format=github --no-progress"
        ],
        "test:unit": [
            "phpunit --testsuite \"Unit tests\""
        ],
        "test:functional": [
            "phpunit --testsuite \"Functional tests\" --bootstrap vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
        ],
        "check": [
            "@check:lint",
            "@check:cgl",
            "@check:phpstan",
            "@test:unit",
            "@test:functional"
        ],
        "ci:check": [
            "@check:lint",
            "@ci:check:cgl",
            "@ci:check:phpstan",
            "@test:unit",
            "@test:functional"
        ],
        "fix": [
            "@fix:cgl"
        ]
    }
}
